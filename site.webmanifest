---
# A page with front matter, so the icon paths go through relative_url like every other asset in the tree.
# Without it this is the one file that breaks silently if baseurl ever stops being empty.
---
{
  "name": "Maker Tip Of The Day",
  "short_name": "Maker Tip",
  "description": "Short, tested tips for the Microsoft business-application stack.",
  "start_url": "{{ '/' | relative_url }}",
  "display": "browser",
  "theme_color": "#fbfaf7",
  "background_color": "#fbfaf7",
  "icons": [
    {
      "src": "{{ '/assets/img/icon-192.png' | relative_url }}",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "{{ '/assets/img/icon-512.png' | relative_url }}",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "{{ '/assets/img/mark.svg' | relative_url }}",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ]
}
